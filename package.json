{
  "name": "dice-roadmap-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @roadmap/shared build && pnpm -r --parallel --filter @roadmap/server --filter @roadmap/web dev",
    "dev:server": "pnpm --filter @roadmap/server dev",
    "dev:web": "pnpm --filter @roadmap/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @roadmap/shared build && pnpm -r typecheck",
    "start": "node apps/server/dist/index.js",
    "tunnel": "node start-tunnel.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.3"
}
